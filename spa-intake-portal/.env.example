# SPA Intake Portal - Environment Configuration
# Toggle between ServiceNow and SQLite backend data sources

# Data Source Mode: "servicenow" or "sqlite"
BACKEND_DATA_SOURCE=sqlite

# ServiceNow Instance URL & Credentials
SNOW_URL=https://fiservdevservicepoint.fiservapp.com
SNOW_USER=
SNOW_PASS=

# ServiceNow Table Names (Pre-filled with your scoped application tables)
SNOW_TITLE_TABLE=x_fise2_software_0_spa_intake_software_title
SNOW_VERSION_TABLE=x_fise2_software_0_software_version
SNOW_REQUEST_TABLE=x_fise2_software_0_spa_intake_request
SNOW_TASK_TABLE=x_fise2_software_0_spa_intake_task

# Server Port
PORT=3002
