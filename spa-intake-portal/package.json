{
  "name": "spa-intake-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server/index.js",
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --experimental-sqlite server/index.js",
    "dev:full": "concurrently --kill-others-on-fail -n server,vite -c blue,cyan \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "vite": "^8.0.10"
  }
}
